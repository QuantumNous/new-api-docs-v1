{
  "openapi": "3.1.0",
  "info": {
    "title": "获取视频生成任务状态",
    "version": "1.0.0",
    "description": "查询视频生成任务的状态和结果。\n\n任务状态：\n- `queued`: 排队中\n- `in_progress`: 生成中\n- `completed`: 已完成\n- `failed`: 失败\n"
  },
  "tags": [
    {
      "name": "视频（Videos）"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 Bearer Token 认证。\n格式: `Authorization: Bearer <YOUR_API_KEY>`\n"
      }
    }
  },
  "paths": {
    "/v1/video/generations/{task_id}": {
      "get": {
        "tags": [
          "视频（Videos）"
        ],
        "summary": "获取视频生成任务状态",
        "description": "查询视频生成任务的状态和结果。任务完成后，`output.video_url` 字段包含生成的视频地址。\n\n任务状态：\n- `queued`: 排队中\n- `in_progress`: 生成中\n- `completed`: 已完成\n- `failed`: 失败\n",
        "operationId": "getvideogeneration",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "任务 ID（创建任务时返回的 `id` 字段）",
            "schema": {
              "type": "string"
            },
            "examples": [
              "task_abc123"
            ]
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取任务状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "视频任务状态查询响应",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "任务 ID",
                      "examples": [
                        "task_abc123"
                      ]
                    },
                    "object": {
                      "type": "string",
                      "description": "对象类型",
                      "examples": [
                        "video.generation"
                      ]
                    },
                    "model": {
                      "type": "string",
                      "description": "使用的模型名称",
                      "examples": [
                        "Seedance 2.0/uP"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "description": "任务状态",
                      "enum": [
                        "queued",
                        "in_progress",
                        "completed",
                        "failed"
                      ],
                      "examples": [
                        "completed"
                      ]
                    },
                    "progress": {
                      "type": "integer",
                      "description": "任务进度（0-100）",
                      "examples": [
                        100
                      ]
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "任务创建时间",
                      "examples": [
                        "2026-06-17T08:00:00Z"
                      ]
                    },
                    "completed_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "任务完成时间（仅 `completed` 或 `failed` 时返回）",
                      "examples": [
                        "2026-06-17T08:01:30Z"
                      ]
                    },
                    "output": {
                      "type": "object",
                      "description": "生成结果（仅 `completed` 时返回）",
                      "properties": {
                        "video_url": {
                          "type": "string",
                          "description": "生成的视频 URL",
                          "examples": [
                            "https://cdn.example.com/output/task_abc123.mp4"
                          ]
                        }
                      },
                      "x-apifox-orders": [
                        "video_url"
                      ]
                    },
                    "error": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "description": "错误信息（失败时返回，成功时为 `null`）",
                      "properties": {
                        "message": {
                          "type": "string",
                          "description": "错误信息"
                        },
                        "code": {
                          "type": "string",
                          "description": "错误代码"
                        }
                      },
                      "x-apifox-orders": [
                        "message",
                        "code"
                      ]
                    }
                  },
                  "x-apifox-orders": [
                    "id",
                    "object",
                    "model",
                    "status",
                    "progress",
                    "created_at",
                    "completed_at",
                    "output",
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "任务不存在",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "description": "错误信息"
                        },
                        "type": {
                          "type": "string",
                          "description": "错误类型"
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "相关参数"
                        },
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "错误代码"
                        }
                      },
                      "x-apifox-orders": [
                        "message",
                        "type",
                        "param",
                        "code"
                      ]
                    }
                  },
                  "x-apifox-orders": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}

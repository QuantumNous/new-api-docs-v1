                                "description": "内联二进制数据(Base64)，用于图片/PDF/音频/视频。不支持 fileData.fileUri 或 File API",
                                "properties": {
                                  "mimeType": {
                                    "type": "string",
                                    "description": "MIME类型。图片: image/jpeg|png|webp|heic|heif; PDF: application/pdf; 音频: audio/mp3|wav|ogg|m4a|flac; 视频: video/mp4|mpeg|mov|avi|webm"
                                  },
                                  "data": {
                                    "type": "string",
                                    "description": "Base64 编码的媒体数据"
                                  }
                                },
                                "x-apifox-orders": [

        "operationId": "geminirelayv1beta-391536411",
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "description": "模型名称",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "contents": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
